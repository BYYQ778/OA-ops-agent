# ============================================================
# 环境变量配置（敏感信息）
# ============================================================
# 复制此文件为 .env 并填写实际值
# .env 文件不会被提交到 Git（已在 .gitignore 中排除）
# ============================================================

# LLM API 密钥（DeepSeek / 千问 / OpenAI）
OA_LLM_API_KEY=your-api-key-here

# Web 登录密码（第 5 周起实际生效；本机回环访问直通，
# 非回环部署必须设置非默认密码，否则服务拒绝启动）
OA_AUTH_PASSWORD=

# SSH 服务器密码（巡检用）
OA_SSH_PASSWORD=

# 邮件告警（SMTP）
OA_EMAIL_USER=your-email@qq.com
OA_EMAIL_PASSWORD=
OA_EMAIL_TO=admin@example.com

# MySQL 密码（如使用 MySQL 数据库）
OA_MYSQL_PASSWORD=

# ---- 可观测性（可选，一般无需设置）----
# OA_LOG_FORMAT=json                # 日志改为 JSON Lines（默认 text）
# OA_TRACING=1                      # 启用 OpenTelemetry（需 pip install opentelemetry-sdk）
# OA_TRACING_EXPORTER=console       # console（调试输出）/ otlp
# OA_TRACING_OTLP_ENDPOINT=         # exporter=otlp 时的接收端点（可指向 Langfuse 等）
# OA_TRACING_OTLP_HEADERS=Authorization=Bearer xxx   # otlp 认证头（可选）

# ---- 认证调参（可选）----
# OA_AUTH_ENABLED=1                 # 等价 auth.enabled
# OA_AUTH_BYPASS_LOOPBACK=0         # 严格模式：回环也要求登录（验证/多用户共用机器时用）
